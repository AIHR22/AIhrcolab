                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.forecasts).to.be.an('array');",
                  "    if(jsonData.forecasts.length > 0) {",
                  "        var forecast = jsonData.forecasts[0];",
