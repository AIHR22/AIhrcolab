        {
          "name": "Get Revenue Comparison",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/revenue/comparison?timeFrame=monthly&metric=revenue",
              "host": ["{{baseUrl}}"],
              "path": ["api", "revenue", "comparison"],
              "query": [
                {
                  "key": "timeFrame",
                  "value": "monthly"
                },
                {
                  "key": "metric",
                  "value": "revenue"
                }
              ]
            }
          }
        },
