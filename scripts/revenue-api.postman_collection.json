            },
            "url": {
              "raw": "{{baseUrl}}/api/scenarios/project/{{projectId}}/custom",
              "host": ["{{baseUrl}}"],
              "path": ["api", "scenarios", "project", "{{projectId}}", "custom"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "authToken",
      "value": "your-auth-token"
    },
    {
      "key": "projectId",
      "value": "test-project-id"
    }
  ]
