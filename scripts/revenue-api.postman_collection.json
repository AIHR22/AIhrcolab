    {
      "name": "Scenario Endpoints",
      "item": [
        {
          "name": "Get Company Predefined Scenarios",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/scenarios/company/predefined",
              "host": ["{{baseUrl}}"],
              "path": ["api", "scenarios", "company", "predefined"]
            }
          }
        },
        {
          "name": "Create Company Custom Scenario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scenario_ids\": [\"scenario-1\"],\n  \"parameters\": {\n    \"start_date\": \"2025-01-01\",\n    \"end_date\": \"2025-12-31\",\n    \"impact_factor\": 1.2\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/scenarios/company/custom",
              "host": ["{{baseUrl}}"],
              "path": ["api", "scenarios", "company", "custom"]
            }
          }
        },
        {
          "name": "Get Project Predefined Scenarios",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/scenarios/project/{{projectId}}/predefined",
              "host": ["{{baseUrl}}"],
              "path": ["api", "scenarios", "project", "{{projectId}}", "predefined"]
            }
          }
        },
        {
          "name": "Create Project Custom Scenario",
          "request": {
            "method": "POST",
