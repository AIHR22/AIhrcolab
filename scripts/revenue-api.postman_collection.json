{
  "info": {
    "name": "Revenue Forecasting API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Revenue Endpoints",
      "item": [
        {
          "name": "Get Current Revenue",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/revenue/current",
              "host": ["{{baseUrl}}"],
              "path": ["api", "revenue", "current"]
            }
          },
          "test": [
            "pm.test('Status code is 200', function() {",
            "  pm.response.to.have.status(200);",
            "});",
            "pm.test('Has amount field', function() {",
            "  const response = pm.response.json();",
            "  pm.expect(response).to.have.property('amount');",
            "});"
          ]
        },
        {
          "name": "Get Revenue Trends",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
